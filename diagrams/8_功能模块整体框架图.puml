@startuml overall_function_framework
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 10
skinparam classBorderColor #000000
skinparam classBackgroundColor #FFFFFF
skinparam rectangleBorderColor #000000
skinparam rectangleBackgroundColor #FFFFFF
skinparam shadowing false
skinparam ranksep 30
skinparam nodesep 10

title HR智慧员工运营系统 - 功能模块整体框架图

top to bottom direction

' ===== 顶部系统 =====
rectangle "HR智慧员工运营系统" as SYS #F0F0F0

' ===== 员工端 =====
rectangle "员工" as emp_title #FFFFFF

rectangle "个人\n信息\n管理" as emp_f1 #F5F5F5
rectangle "人脸\n注册\n识别" as emp_f2 #F5F5F5
rectangle "考勤\n打卡\n记录" as emp_f3 #F5F5F5
rectangle "考勤\n异常\n申请" as emp_f4 #F5F5F5
rectangle "请假\n申请\n查询" as emp_f5 #F5F5F5
rectangle "薪资\n查询\n导出" as emp_f6 #F5F5F5
rectangle "绩效\n评估\n结果" as emp_f7 #F5F5F5
rectangle "工作\n时间\n表" as emp_f8 #F5F5F5

' ===== 经理端 =====
rectangle "经理" as mgr_title #FFFFFF

rectangle "个人\n信息\n管理" as mgr_f1 #F5F5F5
